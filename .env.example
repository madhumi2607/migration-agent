# Copy to .env and fill in. Never commit .env.

# --- LLM provider (used from Week 2; agent/llm.py picks one) ---
# One of: claude | gemini | groq
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Repo tools ---
# Absolute path to the checked-out target repo. repo_tools refuses to touch
# anything outside this directory.
TARGET_REPO_ROOT=

# --- Sandbox ---
# Docker image tag used to run the target repo's tests.
SANDBOX_IMAGE=migration-agent-sandbox:py3.11
# Hard wall-clock limit for one install+pytest run, in seconds.
SANDBOX_TIMEOUT_SECONDS=600
