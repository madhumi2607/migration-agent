# Copy to .env and fill in. Never commit .env.
# Quote values that contain spaces or special characters (uv's --env-file parser requires it).

# --- LLM provider (used from Week 2; agent/llm.py picks one) ---
# One of: claude | gemini | groq
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
# Claude model id and thinking effort (low | medium | high | xhigh | max).
# AGENT_ prefix on purpose: Claude Code sets its own CLAUDE_EFFORT, which would shadow ours.
AGENT_CLAUDE_MODEL=claude-opus-5-5
AGENT_CLAUDE_EFFORT=high
GEMINI_API_KEY=
# Gemini model id. Check availability for your key with `uv run --env-file .env python -m agent.llm --list-models`.
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
# Groq model id (production models only, so benchmark runs stay reproducible).
GROQ_MODEL=openai/gpt-oss-120b

# --- Repo tools ---
# Absolute path to the checked-out target repo. repo_tools refuses to touch
# anything outside this directory.
TARGET_REPO_ROOT=

# --- Sandbox ---
# How the target repo is installed and tested (set per task; see benchmark/tasks.yaml).
# The repo with its OWN dependencies (the agent may change these by editing the repo).
SANDBOX_INSTALL_CMD='pip install -e .'
# Harness test tools and era pins, installed separately afterwards so they can never
# conflict with the agent's dependency changes.
SANDBOX_TEST_DEPS='pytest "shapely>=2.0,<2.1"'
SANDBOX_TEST_CMD='pytest tests'
# Requirement(s) forced on top of the repo's own pins. Empty = run with the old version.
SANDBOX_UPGRADE='pydantic>=2,<3'
# Docker image tag used to run the target repo's tests.
SANDBOX_IMAGE=migration-agent-sandbox:py3.11
# Hard wall-clock limit for one install+pytest run, in seconds.
SANDBOX_TIMEOUT_SECONDS=600
